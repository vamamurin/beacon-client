<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"> <!-- ĐÃ THÊM: Cấu hình tools để tránh lỗi cảnh báo -->

    <!-- ===== Bluetooth + Location permissions (Cũ của bạn) ===== -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- ===== ĐÃ SỬA: Cập nhật quyền quét Bluetooth tối ưu hơn ===== -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET"/>
    
    <!-- ===== ĐÃ THÊM: Các quyền để chạy ngầm, giữ sáng và hiện thông báo ===== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Đi kèm foregroundServiceType="...|location" của keep-alive service.
         Xem ghi chú dài ở khai báo service bên dưới để biết vì sao BLE scan
         cần capability location khi màn hình tắt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- =========================================== -->

    <application
        android:label="beacon_client"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">
        
        <!-- ĐÃ GỠ android:taskAffinity="" (thí nghiệm, xem bên dưới).

             Thuộc tính đó nằm trong repo từ commit đầu tiên (b3f7a92 "initial
             commit with project setup") — chưa bao giờ là bản vá cho vấn đề gì,
             gần như chắc chắn là rác của template.

             VÌ SAO NGHI NÓ: affinity rỗng đẩy MainActivity ra một task KHÔNG
             mang danh tính package. Cả `android:stopWithTask` lẫn
             Service.onTaskRemoved đều được ActivityManager định nghĩa theo
             "task nào vừa bị xoá", và đường dọn dẹp đó đối chiếu task với
             component/package của nó. Trên máy thật, `onTaskRemoved` CHƯA TỪNG
             chạy dù cờ đã đặt đúng ở cả hai service — affinity rỗng là ứng viên
             cấu trúc duy nhất còn lại giải thích được điều đó.

             ⚠ CHƯA ĐƯỢC KIỂM CHỨNG. Đây là thay đổi ĐƠN LẺ, cố ý không đi kèm
             gì khác, để một lần test cho ra một kết luận sạch. Nếu vuốt tắt vẫn
             không ăn thì gỡ dòng này KHÔNG phải nguyên nhân — nhưng vẫn nên để
             gỡ, vì không có lý do nào để giữ. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ===== ĐÃ THÊM: Khai báo dịch vụ AudioService chạy ngầm =====

             stopWithTask="true": VUỐT TẮT APP Ở ĐA NHIỆM PHẢI DỪNG HẲN.
             Mặc định của Android là false, đúng cho một app nghe nhạc (vuốt tắt
             Spotify thì nhạc vẫn chạy). SAI cho máy hướng dẫn bảo tàng: khách
             vuốt tắt là họ đang nói "xong rồi", mà app vẫn thuyết minh trong
             túi và cách duy nhất để dừng là vào Cài đặt > Buộc dừng.

             Chỉ riêng cờ này CHƯA đủ — xem MuseumAudioHandler.onTaskRemoved:
             audio_service chuyển sự kiện xuống Dart, và mặc định ở đó là no-op. -->
        <service android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            android:stopWithTask="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Đầu nhận của PendingIntent scan (xem BeaconScanReceiver.kt).

             exported="false" là ĐÚNG dù broadcast do hệ thống gửi: PendingIntent
             được app tự tạo với component chỉ đích danh, và hệ thống gửi nó
             NHÂN DANH app — không đi qua cổng exported. Để "true" chỉ mở cho app
             khác bơm ScanResult giả vào pipeline định vị của bảo tàng.

             KHÔNG có intent-filter: PendingIntent nhắm thẳng component, filter
             chỉ thừa và làm receiver lộ ra với broadcast ngầm. -->
        <receiver
            android:name=".BeaconScanReceiver"
            android:exported="false" />

        <receiver android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Keep-alive FGS: giữ tiến trình sống suốt tour

             stopWithTask="true" là BẮT BUỘC, không phải tuỳ chọn.
             ForegroundService.onTaskRemoved của plugin đọc đúng cờ này:
                 if (isSetStopWithTaskFlag(this)) stopSelf()
                 else RestartReceiver.setRestartAlarm(this, 1000)
             Không đặt cờ ⇒ service TỰ HẸN GIỜ HỒI SINH sau 1 giây. Đó chính là
             lý do vuốt tắt app không ăn thua và chỉ "Buộc dừng" mới diệt được:
             không phải Android bướng, mà là ta đang bảo plugin hãy sống lại.

             ⚠ ĐẶT CỜ NÀY Ở ĐÂY, KHÔNG PHẢI Ở ForegroundTaskOptions BÊN DART.
             isSetStopWithTaskFlag đọc SharedPreferences trước, manifest sau —
             nên đặt bên Dart *cũng* hiệu quả, nhưng nó kích hoạt thêm một nhánh
             CHỈ chạy khi khoá có trong prefs (ForegroundService.onStartCommand):
                 if (prefs.contains(STOP_WITH_TASK) && prefs.getBoolean(...))
                     TrackVisibilityUtils.install(app) { stopForegroundService() }
             TrackVisibilityUtils gọi callback đó ở onActivityPaused đầu tiên mà
             không còn activity nào resumed — tức là NGAY KHI TẮT MÀN HÌNH.
             Kết quả: keep-alive tự sát đúng lúc cần nhất, kéo theo thả wake lock.
             Đường manifest cho ta stopSelf() lúc vuốt tắt mà KHÔNG dính nhánh đó.
             Xem lib/data/platform/foreground_task_keep_alive.dart.

             foregroundServiceType="specialUse|location":
               • specialUse — không có kiểm tra runtime, không dính trần 6h/24h
                 của dataSync trên Android 15. Lý do chọn ban đầu, giữ nguyên.
               • location  — MẤU CHỐT CỦA LỖI MÀN-TẮT. BLUETOOTH_SCAN ở đây KHÔNG
                 khai neverForLocation, nên BLE scan bị gate qua appop
                 ACCESS_FINE_LOCATION. Từ Android 11, appop location được giải
                 theo PROCESS_CAPABILITY_FOREGROUND_LOCATION, và capability đó
                 chỉ có khi app có activity ĐANG HIỂN THỊ hoặc một FGS khai type
                 location. Hai FGS cũ (mediaPlayback + specialUse) không cấp nó
                 ⇒ màn tắt = mất capability = kết quả scan bị nuốt im lặng, bật
                 màn là có lại ngay. Không cần ACCESS_BACKGROUND_LOCATION vì
                 service luôn được start lúc app đang tiền cảnh (cạnh vào tour).
             KHÔNG truyền serviceTypes từ Dart: khi bỏ trống, plugin dùng
             FOREGROUND_SERVICE_TYPE_MANIFEST = hợp của đúng những type khai ở
             đây, tránh bảng ánh xạ theo SDK level của plugin (specialUse chỉ
             map từ API 34 trở lên, truyền tay sẽ rơi mất trên Android 13). -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse|location"
            android:exported="false"
            android:stopWithTask="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="museum_ble_proximity_keep_alive" />
        </service>
        <!-- ========================================================== -->

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>